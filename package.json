{
  "name": "pvarki-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "docusaurus start",
    "dev:docusaurus": "docusaurus start",
    "dev:reveal-watch": "concurrently -k -n REVEAL -c magenta \"nodemon --watch src/decks --ext md --ignore src/decks/tmp-*.md --exec 'npm run build:reveal:inline'\"",
    "dev": "concurrently -k -n DOCS,REVEAL -c cyan,magenta \"docusaurus start\" \"npm run dev:reveal-watch\"",
    "dev:fi": "docusaurus start --locale fi",
    "build:reveal": "node reveal.build.cjs",
    "build:reveal:inline": "npm run build:reveal && bash ./build.sh",
    "build": "bash ./build.sh && docusaurus build",
    "devdocs:sync:outline": "node ./src/scripts/sync_outline_to_devdocs.mjs",
    "devdocs:sync:repos": "node ./src/scripts/devdocs_sync_repos.mjs",
    "devdocs:build:autoapi": "node ./src/scripts/build_auto_api_docs.mjs",
    "devdocs:generate:firstdocs": "node ./src/scripts/generate_dev_first_docs.mjs",
    "devdocs:sync": "npm run devdocs:sync:outline && npm run devdocs:sync:repos && npm run devdocs:build:autoapi && node ./src/scripts/generate_dev_first_docs.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.8.1",
    "@docusaurus/preset-classic": "3.8.1",
    "@docusaurus/theme-search-algolia": "^3.8.1",
    "jose": "^6.0.11",
    "next": "^15.3.4",
    "swagger-ui-react": "^5.28.1",
    "swiper": "^11.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.34",
    "concurrently": "^8.0.1",
    "dotenv-cli": "^8.0.0",
    "nodemon": "^2.0.22",
    "reveal-md": "^4.0.0",
    "reveal.js": "^5.0.5",
    "reveal.js-mermaid-plugin": "^11.4.1"
  }
}
